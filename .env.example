# Local development against the Firebase emulators (pnpm emulators).
NUXT_PUBLIC_USE_EMULATORS=true
NUXT_PUBLIC_FIREBASE_PROJECT_ID=demo-vita
NUXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-vita.firebaseapp.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Comma-separated emails allowed into /admin (used by pnpm seed).
ADMIN_EMAILS=
